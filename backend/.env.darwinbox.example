# DarwinBox Integration Configuration Example

# DarwinBox API Base URL
DARWINBOX_BASE_URL=https://interviewbit.darwinbox.in

# DarwinBox API Key (required)
# Get this from your DarwinBox admin panel
DARWINBOX_API_KEY=your_api_key_here

# DarwinBox Dataset Key (required)
# Get this from your DarwinBox admin panel
DARWINBOX_DATASET_KEY=your_dataset_key_here

# DarwinBox Basic Authentication
# Option 1: Provide the complete Basic Auth header value
DARWINBOX_BASIC_AUTH=base64_encoded_credentials_here

# Option 2: Provide username and password separately
# The service will automatically encode them
# DARWINBOX_USERNAME=your_username
# DARWINBOX_PASSWORD=your_password

# Note: If none of the auth environment variables are set,
# the service will use the default provided credentials